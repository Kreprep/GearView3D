generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TRAINEE
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  fullName     String
  role         Role              @default(TRAINEE)
  progress     ProgressSnapshot?
  createdAt    DateTime          @default(now())
}

model Equipment {
  id          String  @id
  title       String
  description String  @default("")
  modelUrl    String  @default("")
  // Uniform scale multiplier applied wherever this equipment's model renders
  // (Parts Identification, Walk-Around markers, the admin placement stage).
  // Null means 1x - most GLBs are already authored close to real-world metres,
  // matching forklift.glb, which is the scale baseline every other model is
  // sized against.
  modelScale  Float?
  // Vertical nudge applied after the viewer grounds the model, in scene units
  // (so it is read against the already-scaled model). Null means no nudge.
  // Viewers ground a model by its bounding box, which is only the wheels if
  // nothing else hangs lower - backhoe.glb's buckets do, leaving its tyres
  // above the floor. This is the admin's correction for that.
  modelOffsetY Float?
  imageUrl    String  @default("")
  sortOrder   Int     @default(0)
  // false renders the catalogue card as a non-interactive "Coming Soon"
  // placeholder instead of a link into training.
  available   Boolean @default(true)
  // Admin overrides for the copy on this equipment's training hub and module
  // list - see frontend/src/data/hubContent.js for the keys and their
  // defaults. Holds *only* what an admin changed; a missing or blank key falls
  // back to the coded default, so improving a default still reaches every
  // equipment that never overrode it. No draft column: these are short labels,
  // the same reason Module and ChecklistItem save immediately.
  content     Json?
  // Admin overrides for how this equipment drives in DrivingSimulationViewer -
  // model, rig node names, body footprint, HUD key captions, fail messages.
  // See frontend/src/data/vehicleProfile.js for the keys and their defaults;
  // like `content`, it holds only what an admin changed.
  simConfig   Json?
}

model Module {
  id             Int             @id
  slug           String          @unique
  title          String
  // The long form shown as the module page's own heading. `title` is the short
  // label used in lists; blank here falls back to it.
  fullTitle      String          @default("")
  subtitle       String          @default("")
  description    String          @default("")
  imageUrl       String          @default("")
  sortOrder      Int             @default(0)
  // Which Equipment row this module belongs to. Loose reference (matches the
  // Course.moduleSlug convention below) rather than a formal relation, so
  // deleting an Equipment row never cascades into deleting its modules.
  equipmentId    String          @default("forklift")
  checklistItems ChecklistItem[]
  quizQuestions  QuizQuestion[]

  @@index([equipmentId])
}

// Every 3D marker on every equipment's model - one row per physical component,
// whichever surfaces it appears on. This replaced four tables (Part,
// PartDetail, WalkAroundHotspot, EquipmentHotspot) that each held their own
// copy of the same components: the forklift's mast, forks, tires and three
// others existed as both a Part row and a WalkAroundHotspot row, so moving a
// marker meant moving it twice.
//
// `inParts` / `inWalkAround` say which surfaces a row appears on, not which
// table it came from. A row can be on both (the forklift's mast is a part to
// identify *and* something to inspect), on one, or on neither - a row with no
// surface and a null `position` is a detail card with no marker, which is how
// the walk-around-only ids (tilt-cylinder) are stored.
//
// Fields group by the surface that reads them:
//   always       - label, position, sortOrder, and the detail card every
//                  surface renders (title/subtitle/image/description, markdown)
//   parts        - category (the filter chip), functionText,
//                  inspectionReminder, safetyNote, relatedModule, checklist
//   walk-around  - inspectCategory (inspection grouping, deliberately separate
//                  from the parts chip: the mast is "Load Handling Parts" to
//                  identify but "Exterior condition" to inspect), state,
//                  inspect, safeFeedback, unsafeFeedback, unsafeScenarios
//
// `state` is the engine phase a walk-around marker belongs to; empty means it
// shows in every phase, which is what equipment with no engine-state modelling
// uses. `unsafeScenarios` is an array of scenario ids matching
// `walkAroundDefectOverlays[].scenario` in frontend/src/data/viewerHotspots.js.
//
// Same published-columns + `draft` pattern as Course: the columns are what
// learners see, `draft` is the admin's pending edit as a whole payload, and
// `builtIn` rows have a baseline in frontend/src/data/hotspotDefaults.js they
// can be reset to. Ids are globally unique rather than scoped per equipment,
// because learner progress (`parts.viewedPartIds`) and walk-around step data
// (`data.checks[].hotspot`) reference them bare; new rows are prefixed with
// their equipment id to keep that true.
model Hotspot {
  id          String @id
  equipmentId String
  label       String
  position    Json?
  sortOrder   Int    @default(0)

  inParts      Boolean @default(false)
  inWalkAround Boolean @default(false)

  title       String @default("")
  subtitle    String @default("")
  image       String @default("")
  description String @default("")

  category           String @default("")
  functionText       String @default("")
  inspectionReminder String @default("")
  safetyNote         String @default("")
  relatedModule      String @default("")
  checklist          Json   @default("[]")

  inspectCategory String @default("")
  state           String @default("")
  inspect         String @default("")
  safeFeedback    String @default("")
  unsafeFeedback  String @default("")
  unsafeScenarios Json   @default("[]")

  draft     Json?
  published Boolean  @default(false)
  builtIn   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([equipmentId, sortOrder])
}

// The category filter chips on an equipment's Parts Identification page. `id`
// is the value stored on Hotspot.category, so renaming a category means
// editing its label, not its id.
model HotspotCategory {
  id          String @id
  equipmentId String @default("forklift")
  label       String
  sortOrder   Int    @default(0)

  @@index([equipmentId, sortOrder])
}

// One step of an equipment module (Modules 2-4), in `sortOrder`. Every step is
// a row - there is no hardcoded step list left for these modules - and `kind`
// picks how the page renders it:
//
//   briefing  - reference image + markdown, no simulation
//   driving   - the WASD course DrivingSimulationViewer runs (uses `data`)
//   activity  - a React activity keyed by `content.activityId`
//               (shutdown-sequence, reporting). The screen is code but the
//               cards, answers and feedback are `content`, so admins can edit
//               them; they still cannot author a new activityId.
//   checklist - the module's ChecklistItem rows, ticked off by the learner
//   quiz      - the module's QuizQuestion rows
//   summary   - the auto-built completion grid plus editable copy
//
// The columns hold the *published* version that learners see. `draft` holds the
// admin's unpublished edit as a whole payload
// ({ title, objective, instructions, hint, goalType, data, content }) and is
// null when there is nothing pending, so a half-placed course never reaches a
// learner. `sortOrder` is not drafted - reordering applies immediately.
//
// `data` is driving geometry ({ start, checkpoints, decorations, pallets,
// dropZone, parkingBay, capacityKg, failConditions }) and is null for other
// kinds. `content` is the kind-specific payload for briefing/activity/summary.
// `builtIn` rows have a baseline in frontend/src/data/courseDefaults.js and can
// be reset to it; admin-created rows cannot. New rows start unpublished and
// appear to learners on first publish.
//
// `id` doubles as the step id the module pages key progress on, so renaming a
// course id would orphan learner progress for that step - the dashboard does
// not offer it.
model Course {
  id           String   @id
  moduleSlug   String
  sortOrder    Int      @default(0)
  kind         String   @default("driving")
  title        String
  objective    String   @default("")
  instructions String   @default("")
  hint         String   @default("")
  goalType     String   @default("checkpoints")
  data         Json?
  content      Json?
  draft        Json?
  published    Boolean  @default(false)
  builtIn      Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@index([moduleSlug, sortOrder])
}

model ChecklistItem {
  id        String @id
  module    Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId  Int
  text      String
  sortOrder Int    @default(0)
}

// Every quiz question in the app, module quizzes and parts quizzes alike (the
// PracticeQuestion table was merged in here). `context` says which one:
//
//   'module' - a step of that module's guided simulation; `moduleId` is set and
//              attempts land in progress.quizzes[moduleSlug]
//   'parts'  - the quiz step of that equipment's parts/hotspot page;
//              `moduleId` is null
//
// `options` is an array of plain strings and `answer` must be one of them.
// No draft column: a prompt plus four options is short enough to save
// immediately, the same call as Module and ChecklistItem.
model QuizQuestion {
  id          String  @id
  equipmentId String  @default("forklift")
  context     String  @default("module")
  module      Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId    Int?
  prompt      String
  answer      String
  options     Json
  sortOrder   Int     @default(0)

  @@index([equipmentId, context])
}

// One progress document per user, same JSON shape the frontend keeps in
// localStorage (checklists / parts / quizzes / simulations). Stored as a
// snapshot instead of normalized tables so the training flow can evolve
// without schema migrations.
model ProgressSnapshot {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}
