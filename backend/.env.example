# Copy this file to .env and fill in your local values.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The database (gearview3d) is created for you by `npx prisma migrate dev`.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/gearview3d"

# Secret used to sign login tokens (JWT). Any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API server listens on. The frontend dev server proxies /api to this port.
PORT=4000

# Seeds admin@mail.com/admin123 and trainee@mail.com/trainee123 on every boot.
# Keep true for local dev. Set to false in production (see docker-compose.yml)
# so the known-password admin account doesn't come back after being deleted.
SEED_DEMO_USERS=true
