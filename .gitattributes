# These files run inside Linux containers. With core.autocrlf=true a Windows
# checkout would give them CRLF endings, and a shell script with CRLF fails as
# `bad interpreter: /bin/sh^M`, so pin them to LF regardless of platform.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
docker-compose.yml text eol=lf
