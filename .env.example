# Copy to .env next to docker-compose.yml and fill in. .env is gitignored.
# These are only read by docker compose - local development still uses
# backend/.env (see backend/.env.example).

# PostgreSQL credentials for the postgres container.
POSTGRES_USER=gearview
POSTGRES_DB=gearview3d
# No @ : / ? or # in this, or it has to be percent-encoded in the URL compose
# builds for DATABASE_URL.
POSTGRES_PASSWORD=

# Signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Host port the web container publishes. Point your reverse proxy here.
WEB_PORT=8080

# true replays prisma/content-export.json over the database on every boot,
# overwriting published content with whatever is committed. Leave false unless
# you are deliberately pushing content from git to the server.
IMPORT_CONTENT_ON_BOOT=false
